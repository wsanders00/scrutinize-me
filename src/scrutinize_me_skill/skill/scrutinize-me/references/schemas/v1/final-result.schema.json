{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrutinize-me.invalid/schemas/v1/final-result.schema.json",
  "title": "scrutinize-me v1 final result",
  "examples": [
    {
      "contract_version": "1",
      "review_completeness": {
        "input_status": "available",
        "status": "complete",
        "blocking": false,
        "selected_reviewers": [
          "correctness",
          "security",
          "performance and reliability",
          "architecture and maintainability",
          "contracts and data"
        ],
        "reviewer_statuses": [
          {"reviewer_id": "correctness", "status": "completed"},
          {"reviewer_id": "security", "status": "completed"},
          {"reviewer_id": "performance and reliability", "status": "completed"},
          {"reviewer_id": "architecture and maintainability", "status": "completed"},
          {"reviewer_id": "contracts and data", "status": "completed"}
        ]
      },
      "merge_recommendation": "approve",
      "top_must_fix_issues": [],
      "important_follow_ups": [],
      "reviewed_with_no_major_issues": [
        "correctness",
        "security",
        "performance and reliability",
        "architecture and maintainability",
        "contracts and data"
      ],
      "suggested_tests_before_merge": [],
      "open_questions": [],
      "executive_summary": "No merge-blocking findings remain."
    }
  ],
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "review_completeness", "merge_recommendation", "top_must_fix_issues", "important_follow_ups", "reviewed_with_no_major_issues", "suggested_tests_before_merge", "open_questions", "executive_summary"],
  "properties": {
    "contract_version": {"const": "1"},
    "review_completeness": {"$ref": "#/$defs/completeness"},
    "merge_recommendation": {"enum": ["approve", "approve with follow-ups", "request changes"]},
    "top_must_fix_issues": {"type": "array", "items": {"$ref": "#/$defs/blocker"}},
    "important_follow_ups": {"$ref": "#/$defs/stringArray"},
    "reviewed_with_no_major_issues": {"$ref": "#/$defs/stringArray"},
    "suggested_tests_before_merge": {"$ref": "#/$defs/stringArray"},
    "open_questions": {"$ref": "#/$defs/stringArray"},
    "executive_summary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "stringArray": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "completeness": {
      "type": "object", "additionalProperties": false,
      "required": ["input_status", "status", "blocking", "selected_reviewers", "reviewer_statuses"],
      "properties": {
        "input_status": {"enum": ["available", "unavailable"]},
        "status": {"enum": ["complete", "incomplete"]},
        "blocking": {"type": "boolean"},
        "selected_reviewers": {"type": "array", "items": {"type": "string"}},
        "reviewer_statuses": {"type": "array", "items": {"$ref": "#/$defs/status"}}
      }
    },
    "status": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewer_id", "status"],
      "properties": {
        "reviewer_id": {"type": "string"},
        "status": {"enum": ["completed", "failed", "timed_out", "cancelled", "invalid", "not_run"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "blocker": {
      "type": "object", "additionalProperties": false,
      "required": ["severity", "title", "owners", "file", "function", "why_it_matters", "smallest_fix", "finding_id"],
      "properties": {
        "severity": {"enum": ["critical", "high", "medium", "low"]},
        "title": {"type": "string", "minLength": 1},
        "owners": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "file": {"type": "string"},
        "function": {"type": "string"},
        "location_context": {"type": "string", "minLength": 1},
        "why_it_matters": {"type": "string", "minLength": 1},
        "smallest_fix": {"type": "string", "minLength": 1},
        "finding_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
